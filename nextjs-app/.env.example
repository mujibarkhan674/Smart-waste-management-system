# Smart Waste Management System — environment variables
# Copy to .env.local for local development. NEVER commit real values.

# --- Database (required) ----------------------------------------------------
# PostgreSQL connection string. For hosted Postgres (Neon, Supabase, Vercel
# Postgres) append ?sslmode=require if the provider requires SSL.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/smartwaste
# Optional: max pooled connections per server instance (default 10)
# DATABASE_POOL_MAX=10

# --- Authentication (required) ---------------------------------------------
# Random secret of at least 32 characters, e.g. `openssl rand -base64 32`
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
# Public URL of the app (no trailing slash)
BETTER_AUTH_URL=http://localhost:3000
# Optional extra allowed origins, comma separated
# TRUSTED_ORIGINS=https://smartwaste.example.com

# --- Image classification ---------------------------------------------------
# clip-local (default) | anthropic | demo
#   clip-local: local CLIP zero-shot model, no API key, downloads ~90 MB on first use
#   anthropic : Claude vision via the Anthropic API (needs ANTHROPIC_API_KEY)
#   demo      : SIMULATED results, clearly labelled as not AI — for UI demos only
CLASSIFIER_PROVIDER=clip-local
# Where the CLIP model is cached (default ./.cache/models, or /tmp on Vercel)
# TRANSFORMERS_CACHE_DIR=
# CLIP_MODEL_ID=Xenova/clip-vit-base-patch32
# Set to false to forbid downloading the model at runtime (use a pre-filled cache)
# CLIP_ALLOW_DOWNLOAD=true

# Only for CLASSIFIER_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_CLASSIFIER_MODEL=claude-opus-5-5

# Maximum upload size in MB (keep <= 4 on Vercel, whose request limit is 4.5 MB)
# MAX_UPLOAD_MB=4

# --- Route optimisation -----------------------------------------------------
# haversine (default, straight-line only) | osrm (adds estimated road distance)
ROUTING_PROVIDER=haversine
# OSRM server. The public demo server is for light, non-commercial use only.
# OSRM_URL=https://router.project-osrm.org
# Optional depot / start point used when a route request gives none
# DEPOT_LATITUDE=
# DEPOT_LONGITUDE=
# Assumptions for straight-line time estimates
# ROUTE_AVG_SPEED_KMH=25
# ROUTE_SERVICE_MIN_PER_STOP=5

# --- Statistics --------------------------------------------------------------
# Timezone used for "today" and daily/weekly/monthly buckets
APP_TIMEZONE=Asia/Kolkata

# --- Seed script (optional) --------------------------------------------------
# Passwords for the demo accounts created by `pnpm db:seed`.
# If unset, a default of ChangeMe123! is used and printed — change it!
# SEED_ADMIN_PASSWORD=
# SEED_STAFF_PASSWORD=
# SEED_USER_PASSWORD=
